# Generated output (/build/: the root's only - web/vendor/three/r<N>/build/ is three.js itself)
/build/
exports/
# Drafts and contact sheets for review (.exports/lacing_drafts), and every intermediate file of the pipeline: research
# downloads, stills rounds, notes, measuring scripts (.cache/<pipeline>/). Kept in the repo folder so the maintainer
# and the agents see the same files, not in a tool's temp directory.
.exports/
.cache/
.logs/
__pycache__/
*.pyc
*.FCBak
tests/node_modules/
# web/data/ = the page data (pipeline/share_data.py: no V1E geometry; V1E OK'd shipping it 2026-10-20) is
# committed. The private data with the V1E meshes (fit_config.py) is build/config/, ignored with build/.

# Third-party files: users download their own (parts/ = V1E / Printables STLs, DXFs, STEPs)
parts/*
!parts/manifest.json
# V1E calculator JS + Vector76's SCAD - not ours to redistribute
/vendor/
# OpenSCAD golden outputs (local-only tests)
tests/golden/
*.stl
*.STL
# ...except meshes the maintainer owns (FluidTouch case + stand, MIT): tools/check_no_parts.py OWNED
!web/models/pendant/*.stl
*.step
*.STEP
*.stp
*.dxf
*.DXF
*.3mf
*.obj
*.FCStd

# Private: logs, notes, the user's board files, size builds, STEP export, private publish steps
private/

# wrangler (tools/deploy_dev.py): its local cache
.wrangler/
